# dependencies
node_modules/
.pnpm-store/
.venv/
*.egg-info/

# build / cache
dist/
.next/
# Regenerated by every `next dev` / `next build`, and it references a file
# inside .next/ that a fresh clone does not have. apps/web/next.d.ts is the
# committed equivalent — see the comment there.
apps/web/next-env.d.ts
.turbo/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# secrets — architecture.md Part V §1.1: never .env in the repo
.env
.env.*
!.env.example

# Loose credential scratch files. This repository is PUBLIC and `git add -A` is
# one keystroke; a file holding a live Neon connection string and a Clerk secret
# key must be unstageable by construction, not by remembering.
Api Keys.txt
*[Aa]pi*[Kk]eys*.txt
*.pem
*.key

# local
.DS_Store
Thumbs.db
*.log

# Local object storage. `modules/ingestion/storage.ts` writes sealed blobs here
# when R2 is not configured — real client bytes, envelope-encrypted, but bytes.
tmp/

# ---------------------------------------------------------------------------
# Commercially sensitive — this repository is PUBLIC.
#
# These were committed once and purged from all history on 2026-07-31 with
# git-filter-repo. They are kept in the working tree because the toolchain and
# the source comments still refer to them; they must never re-enter a commit.
#
# Anything containing milestone plans, revenue figures, covenants, pricing or
# vendor cost strategy belongs in this block, not in the repository.
# ---------------------------------------------------------------------------
Compliance-Data-Layer-Master-Roadmap-v6.1.docx
*.docx
architecture.md
claude.md
scratchpad/
**/scratchpad/

# Working patches — intermediate diffs, frequently carry unredacted context.
*.patch
*.diff

# The engineering-only agent briefs are deliberately NOT ignored: they contain
# no commercial material and CI has no dependency on the two files above.
#
# The `claude.md` rule above is case-insensitive on Windows and macOS, so each
# per-package CLAUDE.md needs its own exception. Add one when you add a package.
!apps/validator/CLAUDE.md
!apps/web/CLAUDE.md
"Api Keys.txt" 
