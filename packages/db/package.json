{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "$comment": "--env-file-if-exists so the script works both from a local checkout (.env at the repo root) and from a CI/production shell where CORPUS_DATABASE_URL is already exported.",
    "seed:rules": "tsx --env-file-if-exists=../../.env scripts/seed-rules.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./corpus-connection": "./corpus-connection.ts",
    "./analytics-connection": "./analytics-connection.ts",
    "./transaction": "./transaction.ts",
    "./schema": "./schema/index.ts",
    "./schema/_shared": "./schema/_shared.ts",
    "./schema/app": "./schema/app.ts",
    "./schema/client-data": "./schema/client-data.ts",
    "./schema/corpus": "./schema/corpus.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "fast-xml-parser": "^5.10.1",
    "tsx": "^4.23.1"
  }
}
